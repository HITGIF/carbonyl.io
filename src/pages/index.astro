---
import Base from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const PREVIEW_COUNT = 3;

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<Base title="Carbonyl">
  <section
    id="hero"
    class="relative z-10 flex h-screen w-full items-center justify-center overflow-hidden"
  >
    <main
      class="mx-auto flex w-full max-w-6xl grow items-center justify-center overflow-hidden px-4 py-20"
    >
      <div
        class="hidden h-116 grow flex-col items-center justify-between overflow-hidden md:flex"
      >
        <button
          type="button"
          aria-hidden="true"
          tabindex="-1"
          class="h-32 w-32 cursor-pointer bg-white/0 [box-shadow:inset_0_0_0_12px_white] transition-all duration-200 hover:h-36 hover:bg-white hover:[box-shadow:inset_0_0_0_0_white] focus:h-36 focus:bg-white focus:[box-shadow:inset_0_0_0_0_white] focus:outline-none"
        ></button>
        <button
          type="button"
          aria-hidden="true"
          tabindex="-1"
          class="h-32 w-32 cursor-pointer bg-white/0 [box-shadow:inset_0_0_0_12px_white] transition-all duration-200 hover:h-36 hover:bg-white hover:[box-shadow:inset_0_0_0_0_white] focus:h-36 focus:bg-white focus:[box-shadow:inset_0_0_0_0_white] focus:outline-none"
        ></button>
        <button
          type="button"
          aria-hidden="true"
          tabindex="-1"
          class="h-32 w-32 cursor-pointer bg-white/0 [box-shadow:inset_0_0_0_12px_white] transition-all duration-200 hover:h-36 hover:bg-white hover:[box-shadow:inset_0_0_0_0_white] focus:h-36 focus:bg-white focus:[box-shadow:inset_0_0_0_0_white] focus:outline-none"
        ></button>
      </div>

      <div class="flex grow items-center justify-center overflow-hidden">
        <div
          tabindex="0"
          class="group relative flex h-116 w-116 max-w-[90%] cursor-default items-center justify-center bg-white/0 [box-shadow:inset_0_0_0_12px_white] transition-all duration-200 select-text hover:bg-primary hover:[box-shadow:inset_0_0_0_20px_white] focus:bg-primary focus:[box-shadow:inset_0_0_0_20px_white] focus:outline-none"
        >
          <div
            class="absolute inset-0 flex items-center justify-center p-6 opacity-100 transition-opacity duration-200 group-hover:opacity-0 group-focus:opacity-0 sm:justify-start sm:p-12"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="5.4 0 424.62 570.52"
              preserveAspectRatio="xMinYMin meet"
              class="h-full max-h-86 w-auto max-w-full"
              style="fill: white;"
            >
              <path
                d="M70.92,2.52c23.04,0,43.2-11.34,54-29.16l-24.84-14.4c-5.4,9.72-16.38,15.48-29.16,15.48C48.6-25.56,34.2-40.5,34.2-63s14.4-37.44,36.72-37.44c12.78,0,23.58,5.76,29.16,15.48l24.84-14.4c-10.98-17.82-31.14-29.16-54-29.16C32.94-128.52,5.4-100.08,5.4-63S32.94,2.52,70.92,2.52ZM254.52,0h31.5L243.18-126H206.46L163.62,0h31.5l6.3-19.8h46.8ZM210.06-46.8l14.76-46.26L239.58-46.8ZM399.06,0h30.96L403.2-46.26c13.86-7.02,23.22-21.06,23.22-36.54a43.1,43.1,0,0,0-43.2-43.2h-50.4V0h28.8V-41.4H375.3ZM361.62-99h21.6c7.92,0,14.4,7.02,14.4,16.2s-6.48,16.2-14.4,16.2h-21.6ZM88.92,155.66A31.542,31.542,0,0,0,99.9,131c0-21.78-17.82-36-39.78-36H10.8V221H63.72c22.5,0,40.68-14.58,40.68-36.9A32.535,32.535,0,0,0,88.92,155.66ZM60.12,122c6.66,0,10.98,4.68,10.98,11.16s-4.5,11.16-10.98,11.16H39.6V122Zm3.6,72H39.6V169.88H63.72c7.2,0,11.88,5.04,11.88,12.06S70.92,194,63.72,194Zm151.2,29.52c36.18,0,65.52-28.44,65.52-65.52S251.1,92.48,214.92,92.48,149.4,120.92,149.4,158,178.74,223.52,214.92,223.52Zm0-28.08c-20.52,0-36.72-14.94-36.72-37.44s16.2-37.44,36.72-37.44S251.64,135.5,251.64,158,235.44,195.44,214.92,195.44ZM402.84,95v68.4L354.24,95h-21.6V221h28.8V152.6l48.6,68.4h21.6V95ZM113.4,316H80.64L56.7,364.6,32.76,316H0l42.3,77.58V442H71.1V393.58ZM189,414.28V316H160.2V442H234V414.28Z"
                transform="translate(0 128.52)"></path>
            </svg>
          </div>

          <div
            class="absolute inset-0 m-8 flex flex-col items-center justify-center gap-4 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus:opacity-100 md:m-16"
          >
            <span class="text-6xl leading-none md:text-7xl">🤟</span>
            <a
              href="https://linktr.ee/anhai.wang"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 w-11 items-center justify-center rounded-full transition-colors hover:bg-white/15"
              aria-label="Linktree"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="h-7 w-7"
                fill="currentColor"
              >
                <path d="M16.01 11H4v2h12.01v3L20 12l-3.99-4z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </main>

    <div
      class="pointer-events-none absolute right-0 bottom-6 left-0 flex flex-col items-center gap-2 text-white opacity-70"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        class="h-4 w-4 animate-bounce"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 16l-6-6h12z"></path>
      </svg>
    </div>
  </section>

  <section
    id="posts"
    class="relative z-10 flex min-h-screen w-full flex-col px-4 pt-24 pb-32"
  >
    <div class="mx-auto w-full max-w-3xl">
      <h2 class="mb-10 text-3xl font-bold tracking-tight text-white">Posts</h2>
      <ul class="flex flex-col gap-4">
        {
          posts.map((post) => (
            <li>
              <a
                href={`/posts/${post.id}`}
                transition:name={`post-${post.id}`}
                class="block rounded-lg bg-black/30 p-6 text-white backdrop-blur-md transition-colors hover:bg-black/45"
              >
                {post.data.title && (
                  <h3 class="text-xl font-semibold">{post.data.title}</h3>
                )}
                <time
                  datetime={post.data.date.toISOString()}
                  class:list={[
                    "block text-sm opacity-70",
                    post.data.title && "mt-1",
                  ]}
                >
                  {formatDate(post.data.date)}
                </time>
                {post.data.description && (
                  <p class="mt-3 leading-relaxed opacity-90">
                    {post.data.description}
                  </p>
                )}
                {post.data.images && post.data.images.length > 0 && (
                  <div class="mt-4 grid grid-cols-3 gap-2">
                    {post.data.images
                      .slice(0, PREVIEW_COUNT)
                      .map((image, i) => {
                        const extra =
                          post.data.images!.length - PREVIEW_COUNT;
                        const showOverlay =
                          i === PREVIEW_COUNT - 1 && extra > 0;
                        return (
                          <div class="relative aspect-square overflow-hidden rounded">
                            <Image
                              src={image.src}
                              alt={image.alt ?? image.caption ?? ""}
                              loading="lazy"
                              widths={[240, 480]}
                              sizes="(max-width: 768px) 33vw, 240px"
                              class="h-full w-full object-cover"
                            />
                            {showOverlay && (
                              <div class="absolute inset-0 flex items-center justify-center bg-black/55 text-base font-semibold">
                                +{extra}
                              </div>
                            )}
                          </div>
                        );
                      })}
                  </div>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <script>
    const setup = () => {
      const hero = document.getElementById("hero");
      const posts = document.getElementById("posts");
      if (!hero || !posts) return;
      // Avoid double-binding if astro:page-load fires twice (e.g. SPA + back nav)
      if ((window as any).__heroSnapBound) return;
      (window as any).__heroSnapBound = true;

      const state = {
        animating: false,
        lastWheel: 0,
        touchY: 0,
        timer: null as number | null,
      };

      // Lock for a fixed duration longer than the browser's smooth scroll.
      // Detecting "animation done" from scrollY is unreliable on fast input:
      // the trailing inertia events can sneak in with a flipped sign and
      // trigger a reverse transition (the visible "bounce" back to posts).
      const ANIM_LOCK_MS = 800;

      const animateTo = (el: HTMLElement) => {
        state.animating = true;
        el.scrollIntoView({ behavior: "smooth", block: "start" });
        if (state.timer !== null) clearTimeout(state.timer);
        state.timer = window.setTimeout(() => {
          state.animating = false;
          state.timer = null;
        }, ANIM_LOCK_MS);
      };

      const transition = (dir: number) => {
        if (state.animating) return true;
        const y = window.scrollY;
        const postsTop = posts.offsetTop;
        if (dir > 0 && y < postsTop - 10) {
          animateTo(posts);
          return true;
        }
        if (dir < 0 && y <= postsTop + 10 && y > 10) {
          animateTo(hero);
          return true;
        }
        return false;
      };

      const onWheel = (e: WheelEvent) => {
        if (state.animating) {
          e.preventDefault();
          return;
        }
        // Ignore tail-end inertia events whose deltaY is essentially noise.
        // Without this, a trailing positive blip after a fast up-scroll can
        // flip direction and trigger a transition back to posts.
        if (Math.abs(e.deltaY) < 5) return;
        const now = Date.now();
        if (now - state.lastWheel < 40) return;
        state.lastWheel = now;
        const dir = e.deltaY > 0 ? 1 : -1;
        if (transition(dir)) e.preventDefault();
      };

      const onTouchStart = (e: TouchEvent) => {
        state.touchY = e.touches[0].clientY;
      };

      const onTouchMove = (e: TouchEvent) => {
        if (state.animating) {
          e.preventDefault();
          return;
        }
        const dy = state.touchY - e.touches[0].clientY;
        if (Math.abs(dy) < 20) return;
        const dir = dy > 0 ? 1 : -1;
        if (transition(dir)) {
          e.preventDefault();
          state.touchY = e.touches[0].clientY;
        }
      };

      window.addEventListener("wheel", onWheel, { passive: false });
      window.addEventListener("touchstart", onTouchStart, { passive: true });
      window.addEventListener("touchmove", onTouchMove, { passive: false });

      // Track scroll position + the posts section's offsetTop continuously.
      // On window resize, h-screen on the hero changes, which shifts
      // posts.offsetTop. Without compensation, browser keeps scrollY constant
      // and the user lands mid-page. We shift scrollY by the delta so the
      // relative position within whichever section they're in is preserved.
      let lastY = window.scrollY;
      let lastPostsTop = posts.offsetTop;
      const recordScroll = () => {
        lastY = window.scrollY;
        lastPostsTop = posts.offsetTop;
      };
      let resizeRaf: number | null = null;
      const onResize = () => {
        if (resizeRaf !== null) return;
        resizeRaf = requestAnimationFrame(() => {
          resizeRaf = null;
          const newPostsTop = posts.offsetTop;
          const dY = newPostsTop - lastPostsTop;
          if (lastY >= lastPostsTop && dY !== 0) {
            window.scrollTo(0, lastY + dY);
          }
          recordScroll();
        });
      };
      window.addEventListener("scroll", recordScroll, { passive: true });
      window.addEventListener("resize", onResize);

      const cleanup = () => {
        window.removeEventListener("wheel", onWheel);
        window.removeEventListener("touchstart", onTouchStart);
        window.removeEventListener("touchmove", onTouchMove);
        window.removeEventListener("scroll", recordScroll);
        window.removeEventListener("resize", onResize);
        if (state.timer !== null) {
          clearTimeout(state.timer);
          state.timer = null;
        }
        (window as any).__heroSnapBound = false;
      };

      document.addEventListener("astro:before-swap", cleanup, { once: true });
    };

    document.addEventListener("astro:page-load", setup);
  </script>
</Base>
