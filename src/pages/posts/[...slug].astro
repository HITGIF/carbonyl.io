---
import Base from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const hasImages = !!post.data.images && post.data.images.length > 0;
---

<Base title={post.data.title ? `${post.data.title} — Carbonyl` : "Carbonyl"}>
  <article class="relative z-10 flex min-h-dvh w-full flex-col pt-24 pb-32 sm:px-4">
    <div class="mx-auto flex w-full max-w-3xl flex-col gap-8">
    <a
      href="/#posts"
      data-back
      class="mx-4 self-start text-sm text-white opacity-70 transition-opacity hover:opacity-100 sm:mx-0"
    >
      &larr; Posts
    </a>

    <div
      transition:name={`post-${post.id}`}
      class="bg-black/30 p-8 text-white backdrop-blur-md sm:rounded-lg"
    >
      {
        post.data.title && (
          <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">
            {post.data.title}
          </h1>
        )
      }
      <time
        datetime={post.data.date.toISOString()}
        class:list={[
          "block text-sm opacity-70",
          post.data.title && "mt-2",
        ]}
      >
        {formatDate(post.data.date)}
      </time>
      {
        post.data.description && (
          <p class="mt-3 leading-relaxed opacity-90">{post.data.description}</p>
        )
      }
      <div class="prose prose-invert mt-6 max-w-none leading-relaxed">
        <Content />
      </div>

      {
        hasImages && (
          <div class="mt-8 flex flex-col gap-6">
            {post.data.images!.map((image, i) => (
              <figure
                data-lightbox-image
                data-index={i}
                class="lb-img-wrap group relative cursor-zoom-in overflow-hidden rounded-md"
              >
                <Image
                  src={image.src}
                  alt={image.alt ?? image.caption ?? ""}
                  loading="lazy"
                  widths={[480, 960, 1440]}
                  sizes="(max-width: 768px) 100vw, 720px"
                  class="lb-img block h-auto w-full opacity-0 transition-opacity duration-500"
                />
                {image.caption && (
                  <figcaption class="caption-overlay absolute inset-0 flex select-text items-end bg-linear-to-t from-black/80 via-black/0 to-black/0 p-6 opacity-0 transition-opacity duration-200">
                    <p class="text-base leading-snug text-white md:text-lg">
                      {image.caption}
                    </p>
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        )
      }
    </div>
    </div>
  </article>

  {
    hasImages && (
      <div
        id="lightbox"
        class="fixed inset-0 z-50 hidden bg-black/95"
        aria-hidden="true"
      >
        <button
          id="lb-close"
          type="button"
          aria-label="Close"
          class="absolute top-4 right-4 z-30 flex h-12 w-12 cursor-pointer items-center justify-center text-3xl leading-none text-white opacity-80 transition-opacity hover:opacity-100"
        >
          &times;
        </button>

        <button
          id="lb-prev"
          type="button"
          aria-label="Previous"
          class="group/nav absolute top-0 bottom-0 left-0 z-20 hidden w-1/3 cursor-pointer items-center justify-start pl-12 text-white focus:outline-none focus-visible:outline-none md:flex"
        >
          <span class="flex h-14 w-14 items-center justify-center rounded-full opacity-0 transition-opacity duration-200 group-hover/nav:opacity-(--chevron-op,1) group-focus-visible/nav:opacity-(--chevron-op,1) group-focus-visible/nav:outline-2 group-focus-visible/nav:outline-offset-4 group-focus-visible/nav:outline-white/70">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-7 w-7"
              aria-hidden="true"
            >
              <polyline points="15 6 9 12 15 18" />
            </svg>
          </span>
        </button>
        <button
          id="lb-next"
          type="button"
          aria-label="Next"
          class="group/nav absolute top-0 right-0 bottom-0 z-20 hidden w-1/3 cursor-pointer items-center justify-end pr-12 text-white focus:outline-none focus-visible:outline-none md:flex"
        >
          <span class="flex h-14 w-14 items-center justify-center rounded-full opacity-0 transition-opacity duration-200 group-hover/nav:opacity-(--chevron-op,1) group-focus-visible/nav:opacity-(--chevron-op,1) group-focus-visible/nav:outline-2 group-focus-visible/nav:outline-offset-4 group-focus-visible/nav:outline-white/70">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-7 w-7"
              aria-hidden="true"
            >
              <polyline points="9 6 15 12 9 18" />
            </svg>
          </span>
        </button>

        <div
          id="lb-scroller"
          class="lb-no-scrollbar flex h-full w-full snap-x snap-mandatory overflow-x-auto overflow-y-hidden"
        >
          {post.data.images!.map((image, i) => (
            <div
              data-slide
              data-index={i}
              class="relative flex h-full w-screen shrink-0 snap-start snap-always flex-col items-center"
            >
              <div class="lb-img-wrap relative flex min-h-0 w-full flex-1 items-center justify-center overflow-hidden rounded">
                <Image
                  src={image.src}
                  alt={image.alt ?? image.caption ?? ""}
                  loading="lazy"
                  widths={[1200, 1800, 2400]}
                  sizes="100vw"
                  class="lb-img block h-full max-h-full w-full max-w-full object-contain opacity-0 transition-opacity duration-300"
                />
              </div>
              {image.caption && (
                <p class="absolute right-0 bottom-12 left-0 mx-auto max-w-2xl px-6 text-center text-base leading-snug text-white drop-shadow-md select-text md:text-lg">
                  {image.caption}
                </p>
              )}
            </div>
          ))}
        </div>

        <div
          id="lb-counter"
          class="pointer-events-none absolute right-0 bottom-4 left-0 z-20 text-center text-xs tracking-[0.25em] text-white uppercase opacity-60"
        >
          1 / {post.data.images!.length}
        </div>
      </div>
    )
  }

  <style>
    /* Show grid captions only on devices that actually hover (desktop).
       On touch devices the lightbox handles caption display. */
    @media (hover: hover) {
      figure[data-lightbox-image]:hover .caption-overlay {
        opacity: 1;
      }
    }

    /* Hide horizontal scrollbar on the lightbox carousel. */
    .lb-no-scrollbar {
      scrollbar-width: none;
    }
    .lb-no-scrollbar::-webkit-scrollbar {
      display: none;
    }

    /* Shimmer placeholder shown behind images while they load. */
    @keyframes lb-shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    .lb-img-wrap {
      background-color: rgba(255, 255, 255, 0.04);
      background-image: linear-gradient(
        90deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.08) 50%,
        rgba(255, 255, 255, 0) 100%
      );
      background-size: 200% 100%;
      animation: lb-shimmer 1.4s linear infinite;
    }
    .lb-img-wrap.loaded {
      background: none;
      animation: none;
    }
  </style>

  <script>
    const wireBack = () => {
      document.querySelectorAll<HTMLAnchorElement>("a[data-back]").forEach((a) => {
        if ((a as any).__backWired) return;
        (a as any).__backWired = true;
        a.addEventListener("click", (e) => {
          if (sessionStorage.getItem("inSiteNav") === "1") {
            e.preventDefault();
            // Mark this as a programmatic back so Base.astro keeps our view
            // transition (no native edge-swipe animation competes with it).
            (window as any).__btnBack = true;
            history.back();
          }
        });
      });
    };

    const setupLightbox = () => {
      const lightbox = document.getElementById("lightbox");
      if (!lightbox) return;

      const scroller = document.getElementById("lb-scroller") as HTMLElement;
      const lbCounter = document.getElementById("lb-counter") as HTMLElement;
      const lbClose = document.getElementById("lb-close")!;
      const lbPrev = document.getElementById("lb-prev") as HTMLElement;
      const lbNext = document.getElementById("lb-next") as HTMLElement;

      const figures = Array.from(
        document.querySelectorAll<HTMLElement>("[data-lightbox-image]"),
      );
      const slides = Array.from(
        scroller.querySelectorAll<HTMLElement>("[data-slide]"),
      );
      if (figures.length === 0 || slides.length === 0) return;

      const total = slides.length;
      let current = 0;
      // Whether we currently hold a trapped history entry (see open/close),
      // and the router state of the entry we nulled out so we can restore it.
      let lbEntry = false;
      let savedState: any = null;

      const updateUi = () => {
        lbCounter.textContent = `${current + 1} / ${total}`;
        // Boundary state — chevron stays hidden until hover, then reveals at
        // 1.0 normally, 0.25 if you're at the end of the gallery (visual cue
        // that clicking won't do anything). Button itself stays clickable so
        // the click is absorbed instead of falling through to close.
        lbPrev.style.setProperty(
          "--chevron-op",
          current > 0 ? "1" : "0.25",
        );
        lbNext.style.setProperty(
          "--chevron-op",
          current < total - 1 ? "1" : "0.25",
        );
      };

      // Snappy custom animation: fast start, quick deceleration.
      // Queues naturally — extra clicks just re-target the in-flight tween
      // from wherever the scroller currently is to the new slide.
      const ANIM_MS = 280;
      const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

      let animFrame: number | null = null;
      let animFrom = 0;
      let animTo = 0;
      let animStart = 0;

      const enableSnap = () => {
        scroller.style.scrollSnapType = "";
      };
      const disableSnap = () => {
        // CSS has snap-mandatory which would force every intermediate
        // scrollLeft value back to the nearest snap point, eating the tween.
        scroller.style.scrollSnapType = "none";
      };

      const stopAnim = () => {
        if (animFrame !== null) {
          cancelAnimationFrame(animFrame);
          animFrame = null;
          enableSnap();
        }
      };

      const tick = () => {
        const t = Math.min(1, (performance.now() - animStart) / ANIM_MS);
        scroller.scrollLeft =
          animFrom + (animTo - animFrom) * easeOutCubic(t);
        if (t < 1) {
          animFrame = requestAnimationFrame(tick);
        } else {
          animFrame = null;
          enableSnap();
        }
      };

      const goTo = (i: number) => {
        const target = Math.max(0, Math.min(total - 1, i));
        if (target === current && animFrame === null) return;
        current = target;
        updateUi();
        stopAnim();
        animFrom = scroller.scrollLeft;
        animTo = scroller.clientWidth * current;
        animStart = performance.now();
        disableSnap();
        animFrame = requestAnimationFrame(tick);
      };

      const open = (i: number) => {
        current = Math.max(0, Math.min(total - 1, i));
        updateUi();
        lightbox.classList.remove("hidden");
        lightbox.classList.add("block");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        stopAnim();
        // Jump (no smooth) to the target slide on open.
        requestAnimationFrame(() => {
          scroller.scrollLeft = scroller.clientWidth * current;
        });
        // Trap a history entry so the system Back button / back-swipe closes
        // the lightbox instead of leaving the post. We null the current
        // entry's router state and push a copy of it: on Back, Astro's router
        // gets a null-state popstate and bails via its own early-return
        // (router.js: `if (ev.state === null) return`), so it does NOT
        // re-swap/reload the post page. onPopState restores the state.
        if (!lbEntry) {
          lbEntry = true;
          savedState = history.state;
          history.replaceState(null, "");
          history.pushState(savedState, "");
        }
      };

      // Visually dismiss the lightbox; no history side effects.
      const hide = () => {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("block");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      };

      // Closing via the UI pops our trapped entry; the popstate handler then
      // runs hide(). If somehow there's no entry, hide directly.
      const close = () => {
        if (lbEntry) history.back();
        else hide();
      };

      const next = () => goTo(current + 1);
      const prev = () => goTo(current - 1);

      figures.forEach((f, i) => {
        f.addEventListener("click", () => {
          if (window.getSelection()?.toString().trim()) return;
          open(i);
        });
      });

      lbClose.addEventListener("click", close);
      lbPrev.addEventListener("click", (e) => {
        e.stopPropagation();
        prev();
      });
      lbNext.addEventListener("click", (e) => {
        e.stopPropagation();
        next();
      });

      // Click on the slide background (but not on image or caption) closes.
      slides.forEach((s) => {
        s.addEventListener("click", (e) => {
          if (e.target === s) close();
        });
      });

      // Track current slide from scroll position.
      // Skip while our own animation is driving — we already know `current`.
      let rafPending = false;
      const onScroll = () => {
        if (animFrame !== null) return;
        if (rafPending) return;
        rafPending = true;
        requestAnimationFrame(() => {
          const idx = Math.round(scroller.scrollLeft / scroller.clientWidth);
          if (idx !== current) {
            current = idx;
            updateUi();
          }
          rafPending = false;
        });
      };
      scroller.addEventListener("scroll", onScroll, { passive: true });

      // User touch takes precedence — cancel any in-flight tween.
      scroller.addEventListener(
        "touchstart",
        () => {
          stopAnim();
        },
        { passive: true },
      );

      // Keep the current slide centered if the window is resized.
      const onResize = () => {
        scroller.scrollLeft = scroller.clientWidth * current;
      };
      window.addEventListener("resize", onResize);

      const onKey = (e: KeyboardEvent) => {
        if (lightbox.classList.contains("hidden")) return;
        if (e.key === "Escape") close();
        if (e.key === "ArrowLeft") prev();
        if (e.key === "ArrowRight") next();
      };
      document.addEventListener("keydown", onKey);

      // Back (button / gesture) pops our trapped entry. Astro ignores the
      // null-state popstate, so we just restore the entry's router state and
      // close the overlay — no re-swap, no reload.
      const onPopState = () => {
        if (lbEntry) {
          lbEntry = false;
          history.replaceState(savedState, "");
          hide();
        }
      };
      window.addEventListener("popstate", onPopState);

      const cleanup = () => {
        document.removeEventListener("keydown", onKey);
        window.removeEventListener("resize", onResize);
        window.removeEventListener("popstate", onPopState);
        document.body.style.overflow = "";
      };
      document.addEventListener("astro:before-swap", cleanup, { once: true });
    };

    const wireImageFade = () => {
      document.querySelectorAll<HTMLImageElement>(".lb-img").forEach((img) => {
        if ((img as any).__faded) return;
        (img as any).__faded = true;
        const reveal = () => {
          img.style.opacity = "1";
          img.parentElement?.classList.add("loaded");
        };
        // If the browser already has it (cache / fast network), reveal now.
        if (img.complete && img.naturalWidth > 0) {
          reveal();
        } else {
          img.addEventListener("load", reveal, { once: true });
          img.addEventListener("error", reveal, { once: true });
        }
      });
    };

    document.addEventListener("astro:page-load", () => {
      wireBack();
      setupLightbox();
      wireImageFade();
    });
  </script>
</Base>
